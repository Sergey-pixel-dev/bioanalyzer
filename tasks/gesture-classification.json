{
  "schema_version": 4,
  "task_id": "gesture-classification",
  "display_name": "Gesture classification",
  "task_type": "classification",
  "target_type": "label",
  "paradigm": {
    "kind": "cue_schedule",
    "prep_s": 5,
    "record_s": 5,
    "randomize": true
  },
  "events": [],
  "capture": {
    "channels": [],
    "sample_rate": 2000,
    "units": "uV"
  },
  "quality": {
    "modality": "emg",
    "skip_ms": 500,
    "edge_ms": 50,
    "group_by": {"field": "label"},
    "checks": [
      {"id": "deviation", "params": {"threshold": 3.5, "min_group": 15}},
      {"id": "crest", "params": {"threshold": 3.5, "min_reference": 15}},
      {"id": "low_frequency", "params": {"cutoff_hz": 20, "threshold": 3.5, "min_reference": 15}},
      {"id": "saturation", "params": {"margin": 0.01, "max_share": 0.001}},
      {"id": "flat", "params": {"min_rms": 0.5}}
    ]
  }
}
